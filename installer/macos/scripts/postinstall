#!/bin/bash
# После установки: автозапуск и запуск агента у вошедшего пользователя.
# Скрипт идёт от root; всё пользовательское делаем от имени владельца консоли.
# Ошибки пользовательской части установку не валят. Вывод -- в /var/log/install.log.

APP="/Applications/rcdesk.app"

user="$(stat -f %Su /dev/console 2>/dev/null || true)"
case "$user" in
  "" | root | loginwindow)
    echo "rcdesk postinstall: пользователь консоли не определён ('$user'), автозапуск и запуск пропущены"
    exit 0
    ;;
esac

uid="$(id -u "$user" 2>/dev/null || true)"
if [ -z "$uid" ]; then
  echo "rcdesk postinstall: не найден uid пользователя '$user', пропуск"
  exit 0
fi

echo "rcdesk postinstall: пользователь $user (uid $uid)"

# LaunchAgent в ~/Library/LaunchAgents пишет сам rcdesk-host (launchctl он не
# вызывает), поэтому запускаем его от имени пользователя, а не root. `-H`
# обязателен: хост берёт домашний каталог из $HOME, а sudo на macOS по
# умолчанию оставляет HOME вызывающего (root) -- plist лёг бы в /var/root.
# `restore` включает автозапуск, только если пользователь не выключал его в
# меню агента (метка autostart-disabled); итог печатает сама команда.
if autostart_out="$(sudo -H -u "$user" "$APP/Contents/MacOS/rcdesk-host" autostart restore 2>&1)"; then
  echo "rcdesk postinstall: $autostart_out"
else
  echo "rcdesk postinstall: не удалось настроить автозапуск (код $?): $autostart_out"
fi

# Запуск агента через launchd, а не `open -a` (I9). Агент держит блокировку
# единственного экземпляра и при занятой блокировке выходит с кодом 0, а
# KeepAlive {SuccessfulExit=false} после успешного выхода не перезапускает.
# Запущенный в обход launchd экземпляр (open) занимает блокировку; поздно
# стартовавшая launchd-копия выходит с 0, и задание остаётся без процесса.
# Агент оказывается вне launchd, и после jetsam его никто не поднимает.
# Поэтому `open -a` оставлен только последней страховкой.
label="app.rcdesk.agent"
started=0

if [ -f "/Library/LaunchAgents/$label.plist" ]; then
  # Полный режим (D51): preinstall выгрузил задание, пользовательского plist нет.
  # Пакет полный режим сам не включает, только возвращает задание; `restore`
  # идёт от root (в нём сам `launchctl asuser`) и идемпотентен.
  if restore_out="$("$APP/Contents/MacOS/rcdesk-host" fullmode restore --uid "$uid" 2>&1)"; then
    echo "rcdesk postinstall: $restore_out"
  else
    echo "rcdesk postinstall: не удалось вернуть задание полного режима (код $?): $restore_out"
  fi
  started=1
else
  home="$(dscl . -read "/Users/$user" NFSHomeDirectory 2>/dev/null | sed -n 's/^NFSHomeDirectory: //p' || true)"
  plist=""
  if [ -n "$home" ]; then
    plist="$home/Library/LaunchAgents/$label.plist"
  fi

  if [ -n "$plist" ] && [ -f "$plist" ]; then
    # Порядок попыток -- как в `load_job_attempts` (host/src/fullmode.rs): из
    # root голый bootstrap/kickstart падает, поэтому сначала через
    # `launchctl asuser`, затем те же команды без него.
    if launchctl asuser "$uid" /bin/launchctl bootstrap "gui/$uid" "$plist"; then
      echo "rcdesk postinstall: задание $label загружено через launchctl asuser bootstrap"
      started=1
    elif launchctl asuser "$uid" /bin/launchctl kickstart -k "gui/$uid/$label"; then
      echo "rcdesk postinstall: задание $label уже было загружено, перезапущено через asuser kickstart -k"
      started=1
    elif launchctl bootstrap "gui/$uid" "$plist"; then
      echo "rcdesk postinstall: задание $label загружено через launchctl bootstrap"
      started=1
    elif launchctl kickstart -k "gui/$uid/$label"; then
      echo "rcdesk postinstall: задание $label уже было загружено, перезапущено через kickstart -k"
      started=1
    else
      echo "rcdesk postinstall: bootstrap и kickstart не удались, запасной путь через open"
    fi
  else
    echo "rcdesk postinstall: plist '$plist' не найден, запасной путь через open"
  fi
fi

if [ "$started" -eq 0 ]; then
  # `launchctl asuser <uid>` переносит команду в bootstrap-контекст сессии
  # (иначе open из root-скрипта установщика не достучится до WindowServer),
  # `sudo -u` снимает права root, чтобы агент работал от пользователя.
  if launchctl asuser "$uid" sudo -H -u "$user" /usr/bin/open -a "$APP"; then
    echo "rcdesk postinstall: агент запущен через open"
  else
    echo "rcdesk postinstall: не удалось запустить агент (код $?)"
  fi
fi

# Диагностика состояния задания (не валит установку, если задания нет).
sleep 1
launchctl print "gui/$uid/$label" 2>/dev/null | grep -E '^[[:space:]]*(state =|pid =|last exit code)' | sed 's/^[[:space:]]*/rcdesk postinstall: /' || echo "rcdesk postinstall: задание $label не загружено"

exit 0
