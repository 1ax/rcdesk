# Шаблон секретов для infra/docker-compose.prod.yml. На сервере копируется в
# .env рядом с compose-файлом (~/app/.env, chmod 600, владелец rcdesk).

IMAGE_TAG=latest

# coturn: тот же секрет, что RCDESK_TURN_SECRET ниже -- сервер подписывает
# TURN-креды тем же ключом, которым coturn их проверяет. Сгенерировать:
# openssl rand -hex 32
TURN_SECRET=
# Внешний IP сервера (coturn отдаёт его в relay-кандидатах).
TURN_EXTERNAL_IP=

# rcdesk-server: ICE-серверы, отдаваемые в Registered/Joined (см.
# server/src/ice.rs). RCDESK_TURN_SECRET должен совпадать с TURN_SECRET выше.
RCDESK_STUN_URLS=stun:stun.l.google.com:19302
RCDESK_TURN_URLS=turn:turn.rcdesk.app:3478?transport=udp,turn:turn.rcdesk.app:3478?transport=tcp
RCDESK_TURN_SECRET=
RCDESK_TURN_TTL_SECS=86400
