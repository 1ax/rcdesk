# Шаблон секретов для infra/docker-compose.prod.yml. На сервере копируется в
# .env рядом с compose-файлом (~/app/.env, chmod 600, владелец rcdesk).

IMAGE_TAG=latest

# coturn: тот же секрет, что RCDESK_TURN_SECRET ниже -- сервер подписывает
# TURN-креды тем же ключом, которым coturn их проверяет. Сгенерировать:
# openssl rand -hex 32
TURN_SECRET=
# Внешний IP сервера (coturn отдаёт его в relay-кандидатах).
TURN_EXTERNAL_IP=

# rcdesk-server: ICE-серверы, отдаваемые в Registered/Joined (см.
# server/src/ice.rs). RCDESK_TURN_SECRET должен совпадать с TURN_SECRET выше.
RCDESK_STUN_URLS=stun:stun.l.google.com:19302
RCDESK_TURN_URLS=turn:turn.rcdesk.app:3478?transport=udp,turn:turn.rcdesk.app:3478?transport=tcp
RCDESK_TURN_SECRET=
RCDESK_TURN_TTL_SECS=86400

# infra/traffic-monitor.sh: Telegram-бот для уведомлений о трафике (§11).
# Пусто -- уведомления пропускаются с сообщением в stderr.
TRAFFIC_TG_BOT_TOKEN=
TRAFFIC_TG_CHAT_ID=

# infra/backup-db.sh: ежедневный шифрованный бэкап БД (infra/README.md, «Бэкап БД»).
# Отпечаток открытого GPG-ключа владельца; пусто -- скрипт падает.
BACKUP_GPG_RECIPIENT=
# Better Stack heartbeat URL; пусто -- heartbeat пропускается.
BACKUP_HEARTBEAT_URL=

# Почта с кодами (вход/регистрация/сброс по email, слайс 3.8). Провайдер --
# Resend (SMTP, implicit TLS). Ключ API создавать только с правом отправки
# («Sending access»), домен отправителя rcdesk.app должен быть подтверждён в
# Resend. RCDESK_MAIL: smtp -- слать письма, log -- код в лог (разработка),
# пусто -- почта выключена. При smtp пароль обязателен, иначе сервер не стартует.
RCDESK_MAIL=smtp
RCDESK_SMTP_HOST=smtp.resend.com
# 465 -- implicit TLS; запасной вариант 2465 (тоже implicit TLS).
RCDESK_SMTP_PORT=465
RCDESK_SMTP_USER=resend
# API-ключ Resend.
RCDESK_SMTP_PASSWORD=
RCDESK_MAIL_FROM=rcdesk <noreply@rcdesk.app>
